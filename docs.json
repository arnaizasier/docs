{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mintlify Starter Kit",
  "colors": {
    "primary": "#024DDF",
    "light": "#3D6EF6",
    "dark": "#0139A8"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Legal",
        "pages": [
          "terminos-y-condiciones",
          "politica-de-privacidad"
        ]
      },
      {
        "group": "Centro de ayuda",
        "pages": [
          {
            "group": "Para usuarios",
            "pages": [
              "faqs/usuarios"
            ]
          },
          {
            "group": "Para negocios",
            "pages": [
              "faqs/negocios"
            ]
          },
          {
            "group": "Para restaurantes",
            "pages": [
              "faqs/restaurantes"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/buscounservicio.svg",
    "dark": "/logo/buscounservicio.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}